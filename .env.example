# --- LLM (Master Agent brain / tool-calling) ---
# "ollama"    -> free, local model, no API key needed (default)
# "anthropic" -> Claude via paid Anthropic API
LLM_BACKEND=ollama

# Ollama settings (used when LLM_BACKEND=ollama)
# 1. Install: https://ollama.com/download
# 2. Pull a tool-calling-capable model:  ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Anthropic settings (only used when LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# --- Run mode ---
# true  -> use built-in mock mailbox/calendar, no Google setup required (great for first run/demo)
# false -> use real Gmail + Google Calendar via OAuth2 (see README "Google setup")
MOCK_MODE=true

# --- Google OAuth (only needed once MOCK_MODE=false) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_CREDENTIALS_PATH=storage/credentials.json
GOOGLE_TOKEN_PATH=storage/token.json

# --- Storage ---
STATE_DB_PATH=storage/larvi_state.sqlite3

# --- Server ---
HOST=0.0.0.0
PORT=8000
